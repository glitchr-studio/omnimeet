# The gateways' settings: copy to .env (git-ignored), fill in what you have.
# `docker compose run --rm omnimeet gateways` says what is installed and configured.

# Where the gateways' checkouts are, when this core sits in the workspace
# beside them (../.. from this directory); unset, they come from GitHub.
#OMNIMEET_PLUGINS=../..

# The demo's port (docker compose up).
#OMNIMEET_PORT=8799

# omnimeet/direct needs nothing. With a TURN relay of your own (coturn,
# use-auth-secret): its shared secret and its addresses, comma-separated.
TURN_SECRET=
TURN_URLS=
STUN_URLS=

# omnimeet/jitsi: the instance. An open one needs nothing more.
JITSI_DOMAIN=
# An instance with token authentication: Prosody's app_id and app_secret...
JITSI_APP_ID=
JITSI_APP_SECRET=
# ...or a key pair (the path of the private key, or its PEM) and the key's name.
# Jitsi as a Service: JITSI_DOMAIN=8x8.vc, JITSI_APP_ID the AppID, the API key's pair and id.
JITSI_PRIVATE_KEY=
JITSI_KEY_ID=
# JaaS: the webhook endpoint's signing secret (whsec_...).
JAAS_WEBHOOK_SECRET=
